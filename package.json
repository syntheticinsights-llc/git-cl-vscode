{
  "name": "git-cl-vscode",
  "displayName": "git-cl — Changelist Manager",
  "description": "Manage git changelists directly in VS Code. Organizes working changes into logical groups for focused commits.",
  "version": "0.1.9",
  "packageManager": "pnpm@12.9.1",
  "publisher": "waylit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WayLit/git-cl-vscode.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-cl.showStatus",
        "title": "Show Changelist Status",
        "category": "git-cl",
        "icon": "$(list-unordered)"
      },
      {
        "command": "git-cl.addToChangelist",
        "title": "Add to Changelist",
        "category": "git-cl",
        "icon": "$(add)"
      },
      {
        "command": "git-cl.removeFromChangelist",
        "title": "Remove from Changelist",
        "category": "git-cl",
        "icon": "$(close)"
      },
      {
        "command": "git-cl.openFileDiff",
        "title": "Open Diff",
        "category": "git-cl",
        "icon": "$(diff)"
      },
      {
        "command": "git-cl.deleteChangelist",
        "title": "Delete Changelist",
        "category": "git-cl",
        "icon": "$(trash)"
      },
      {
        "command": "git-cl.deleteAllChangelists",
        "title": "Delete All Changelists",
        "category": "git-cl",
        "icon": "$(trash)"
      },
      {
        "command": "git-cl.stageChangelist",
        "title": "Stage Changelist",
        "category": "git-cl",
        "icon": "$(add)"
      },
      {
        "command": "git-cl.unstageChangelist",
        "title": "Unstage Changelist",
        "category": "git-cl",
        "icon": "$(remove)"
      },
      {
        "command": "git-cl.commitChangelist",
        "title": "Commit Changelist",
        "category": "git-cl",
        "icon": "$(check)"
      },
      {
        "command": "git-cl.diffChangelist",
        "title": "Diff Changelist",
        "category": "git-cl",
        "icon": "$(diff)"
      },
      {
        "command": "git-cl.checkoutChangelist",
        "title": "Checkout (Revert) Changelist",
        "category": "git-cl",
        "icon": "$(discard)"
      },
      {
        "command": "git-cl.stashChangelist",
        "title": "Stash Changelist",
        "category": "git-cl",
        "icon": "$(archive)"
      },
      {
        "command": "git-cl.stashAllChangelists",
        "title": "Stash All Changelists",
        "category": "git-cl"
      },
      {
        "command": "git-cl.unstashChangelist",
        "title": "Unstash Changelist",
        "category": "git-cl",
        "icon": "$(package)"
      },
      {
        "command": "git-cl.unstashChangelistForce",
        "title": "Unstash Changelist (Force)",
        "category": "git-cl"
      },
      {
        "command": "git-cl.unstashAllChangelists",
        "title": "Unstash All Changelists",
        "category": "git-cl"
      },
      {
        "command": "git-cl.branchFromChangelist",
        "title": "Branch from Changelist",
        "category": "git-cl",
        "icon": "$(git-branch)"
      },
      {
        "command": "git-cl.viewAsTree",
        "title": "View as Tree",
        "category": "git-cl",
        "icon": "$(list-tree)"
      },
      {
        "command": "git-cl.viewAsList",
        "title": "View as List",
        "category": "git-cl",
        "icon": "$(list-flat)"
      },
      {
        "command": "git-cl.pruneChangelist",
        "title": "Prune Unchanged Files",
        "category": "git-cl",
        "icon": "$(clear-all)"
      },
      {
        "command": "git-cl.pruneAllChangelists",
        "title": "Prune Unchanged Files in All Changelists",
        "category": "git-cl",
        "icon": "$(clear-all)"
      },
      {
        "command": "git-cl.copyFromChangelist",
        "title": "Copy from Changelist…",
        "category": "git-cl",
        "icon": "$(copy)"
      },
      {
        "command": "git-cl.editReviewTemplate",
        "title": "Edit Review Prompt Template",
        "category": "git-cl",
        "icon": "$(edit)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "git-cl.changelists",
          "name": "Changelists",
          "icon": "$(list-tree)",
          "when": "git-cl:hasGitRoot"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "git-cl.changelists",
        "contents": "No changelists yet.\n[Add to Changelist](command:git-cl.addToChangelist)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "git-cl.copyFromChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@0"
        },
        {
          "command": "git-cl.stageChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@1"
        },
        {
          "command": "git-cl.unstageChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@2"
        },
        {
          "command": "git-cl.commitChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@3"
        },
        {
          "command": "git-cl.pruneChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@8"
        },
        {
          "command": "git-cl.deleteChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "inline@9"
        },
        {
          "command": "git-cl.stageChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "1_modification@1"
        },
        {
          "command": "git-cl.unstageChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "1_modification@2"
        },
        {
          "command": "git-cl.commitChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "1_modification@3"
        },
        {
          "command": "git-cl.deleteChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "1_modification@4"
        },
        {
          "command": "git-cl.pruneChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "1_modification@5"
        },
        {
          "command": "git-cl.diffChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "2_diff@1"
        },
        {
          "command": "git-cl.copyFromChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "2_diff@2"
        },
        {
          "command": "git-cl.checkoutChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "3_revert@1"
        },
        {
          "command": "git-cl.stashChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "4_stash@1"
        },
        {
          "command": "git-cl.branchFromChangelist",
          "when": "view == git-cl.changelists && viewItem == changelist",
          "group": "5_branch@1"
        },
        {
          "command": "git-cl.unstashChangelist",
          "when": "view == git-cl.changelists && viewItem == stashedChangelist",
          "group": "inline@1"
        },
        {
          "command": "git-cl.unstashChangelist",
          "when": "view == git-cl.changelists && viewItem == stashedChangelist",
          "group": "1_modification@1"
        },
        {
          "command": "git-cl.unstashChangelistForce",
          "when": "view == git-cl.changelists && viewItem == stashedChangelist",
          "group": "1_modification@2"
        },
        {
          "command": "git-cl.openFileDiff",
          "when": "view == git-cl.changelists && viewItem == changelistFile",
          "group": "inline@1"
        },
        {
          "command": "git-cl.removeFromChangelist",
          "when": "view == git-cl.changelists && viewItem =~ /^changelist(File|Folder)$/",
          "group": "inline@2"
        },
        {
          "command": "git-cl.removeFromChangelist",
          "when": "view == git-cl.changelists && viewItem =~ /^changelist(File|Folder)$/",
          "group": "1_modification"
        },
        {
          "command": "git-cl.openFileDiff",
          "when": "view == git-cl.changelists && viewItem == changelistFile",
          "group": "2_diff"
        },
        {
          "command": "git-cl.addToChangelist",
          "when": "view == git-cl.changelists && viewItem =~ /^unassigned(File|Folder)$/",
          "group": "inline@1"
        },
        {
          "command": "git-cl.addToChangelist",
          "when": "view == git-cl.changelists && viewItem =~ /^unassigned(File|Folder)$/",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "git-cl.viewAsTree",
          "when": "view == git-cl.changelists && git-cl:viewMode == list",
          "group": "navigation"
        },
        {
          "command": "git-cl.viewAsList",
          "when": "view == git-cl.changelists && git-cl:viewMode == tree",
          "group": "navigation"
        },
        {
          "command": "git-cl.pruneAllChangelists",
          "when": "view == git-cl.changelists",
          "group": "navigation"
        },
        {
          "command": "git-cl.deleteAllChangelists",
          "when": "view == git-cl.changelists",
          "group": "overflow"
        },
        {
          "command": "git-cl.stashAllChangelists",
          "when": "view == git-cl.changelists",
          "group": "overflow"
        },
        {
          "command": "git-cl.unstashAllChangelists",
          "when": "view == git-cl.changelists",
          "group": "overflow"
        },
        {
          "command": "git-cl.editReviewTemplate",
          "when": "view == git-cl.changelists",
          "group": "overflow"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "git-cl.addToChangelist",
          "when": "scmProvider == git",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "git-cl",
      "properties": {
        "git-cl.viewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "enumDescriptions": [
            "Show files grouped by folder.",
            "Show files as a flat list."
          ],
          "default": "tree",
          "description": "Controls whether changelist files are shown as a tree or a list. Folders are compacted according to `#scm.compactFolders#`."
        },
        "git-cl.review.templateFile": {
          "type": "string",
          "default": ".vscode/git-cl-review-prompt.md",
          "markdownDescription": "Review prompt template, relative to the repository root. Supports `{{changelist}}` and `{{files}}` placeholders. Falls back to a built-in template when the file does not exist; run **git-cl: Edit Review Prompt Template** to create it."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=es2020 --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "npm run build -- --minify && vsce package $(semver -i prerelease $(node -p \"require('./package.json').version\"))",
    "install-local": "bash scripts/install-local.sh",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "~1.107.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "semver": "^7.7.4",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
